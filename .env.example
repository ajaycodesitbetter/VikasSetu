# Copy this file to .env (or set these in your hosting provider's environment
# variables) before building. Both are read in browser code, so they are baked
# into the build output.
#
# VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY — a Google Maps JavaScript API
# key. Add your own domain to that key's allowed HTTP referrers in Google Cloud
# Console, or the district maps show a "map unavailable" message while the rest
# of the app keeps working.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=

# VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID — optional reporting channel
# label for the map key. Safe to leave as vikassetu.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=vikassetu
